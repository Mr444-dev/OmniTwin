<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="TacticalHud.uss" />
    <ui:VisualElement name="screen" class="screen" picking-mode="Ignore">
        <ui:VisualElement class="header">
            <ui:VisualElement>
                <ui:Label text="OMNITWIN" class="brand" />
                <ui:Label text="PERCEPTION / DIGITAL TWIN" class="eyebrow" />
            </ui:VisualElement>
            <ui:VisualElement class="camera-toolbar" picking-mode="Position">
                <ui:VisualElement class="workspace-meta">
                    <ui:Label text="REFERENCE WORKSPACE" class="world-title" />
                    <ui:Label text="20 x 12.5 m / X-Z PLANE" class="world-detail" />
                </ui:VisualElement>
                <ui:VisualElement class="camera-presets" picking-mode="Position">
                    <ui:Button name="view1Button" text="1 · ISO" class="camera-button" />
                    <ui:Button name="view2Button" text="2 · MAP" class="camera-button" />
                    <ui:Button name="view3Button" text="3 · CHASE" class="camera-button" />
                </ui:VisualElement>
                <ui:DropdownField name="cameraAgent" label="CHASE AGENT" class="camera-agent" />
            </ui:VisualElement>
            <ui:VisualElement class="header-right">
                <ui:Label name="statusBadge" text="NO OBSERVATION" class="badge" />
                <ui:Label name="connectionState" text="Connecting to local backend" class="connection" />
                <ui:Label name="sourceModeBanner" text="SOURCE: WAITING FOR BACKEND" class="source-mode" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="body" picking-mode="Ignore">
            <ui:VisualElement class="sidebar observation-panel" picking-mode="Position">
                <ui:Label text="WORLD OBSERVATION" class="section-title" />
                <ui:Button name="previewToggleButton" text="SHOW CAMERA PREVIEW" class="mission-button preview-toggle" />
                <ui:Label name="previewStatus" text="Camera preview off" class="media-status" />
                <ui:Button name="maskToggleButton" text="SHOW SAM MASKS" class="mission-button preview-toggle" />
                <ui:Label name="maskStatus" text="Masks unavailable · no current image" class="media-status" />
                <ui:Label name="trackCount" text="--" class="big-value" />
                <ui:Label text="CURRENT OBSTACLE TRACKS" class="value-caption" />
                <ui:VisualElement class="metric">
                    <ui:Label text="Hazard tracks" class="metric-name" />
                    <ui:Label name="hazardCount" text="--" class="metric-value" />
                </ui:VisualElement>
                <ui:VisualElement class="metric">
                    <ui:Label text="Observation age" class="metric-name" />
                    <ui:Label name="sourceAge" text="--" class="metric-value" />
                </ui:VisualElement>
                <ui:VisualElement class="metric">
                    <ui:Label text="Publication" class="metric-name" />
                    <ui:Label name="publication" text="--" class="metric-value" />
                </ui:VisualElement>
                <ui:VisualElement class="metric">
                    <ui:Label text="Calibration" class="metric-name" />
                    <ui:Label name="calibration" text="--" class="metric-value" />
                </ui:VisualElement>
                <ui:VisualElement name="previewFrame" class="camera-preview preview-hidden" picking-mode="Ignore">
                    <ui:Image name="cameraPreview" class="preview-image" picking-mode="Ignore" />
                    <ui:Image name="maskPreview" class="preview-image" picking-mode="Ignore" />
                    <ui:Label name="previewReplayBadge" text="SYNTHETIC REPLAY · LOCAL CV" class="preview-replay-badge preview-hidden" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:Label name="sourceNotice" text="Waiting for a calibrated camera observation." class="notice" />
                <ui:Button name="reconnectButton" text="RECONNECT STREAM" class="action reconnect" />
            </ui:VisualElement>
            <ui:VisualElement class="world-column" picking-mode="Ignore">
                <ui:VisualElement class="world-stage" picking-mode="Ignore" />
                <ui:VisualElement class="command-dock" picking-mode="Position">
                    <ui:Label text="AI COMMAND &amp; MODEL MATRIX DOCK" class="dock-title" />
                    <ui:VisualElement name="modelMatrix" class="model-matrix">
                        <ui:Label name="modelSam" text="SAM 3.1&#10;WAITING" class="model-card" />
                        <ui:Label name="modelSparkOpen" text="MUSE SPARK OPEN&#10;WAITING" class="model-card" />
                        <ui:Label name="modelSemantic" text="MUSE SPARK 1.3&#10;WAITING" class="model-card" />
                        <ui:Label name="modelVoice" text="MUSE VOICE&#10;WAITING" class="model-card" />
                        <ui:Label name="modelImage" text="MUSE IMAGE&#10;WAITING" class="model-card" />
                        <ui:Label name="modelSandbox" text="ROSLYN + APPCONTAINER&#10;WAITING" class="model-card sandbox-card" />
                    </ui:VisualElement>
                    <ui:VisualElement class="dock-tabs">
                        <ui:Button name="brainTab" text="BRAIN &amp; VOICE" class="dock-tab selected" />
                        <ui:Button name="semanticsTab" text="OBJECT SEMANTICS" class="dock-tab" />
                        <ui:Button name="sceneryTab" text="MUSE IMAGE" class="dock-tab" />
                    </ui:VisualElement>
                    <ui:VisualElement name="brainView" class="dock-view brain-view active">
                        <ui:VisualElement class="command-primary-row">
                            <ui:VisualElement class="voice-column">
                                <ui:Button name="recordVoiceButton" text="RECORD VOICE" class="mission-button voice-record" />
                                <ui:VisualElement class="mission-row voice-actions">
                                    <ui:Button name="cancelVoiceButton" text="CANCEL" class="mission-button" />
                                    <ui:Button name="useTranscriptButton" text="USE TRANSCRIPT" class="mission-button" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:TextField name="missionInstruction" label="MISSION INSTRUCTION" multiline="true" max-length="4096" class="mission-input" />
                            <ui:VisualElement class="synthesis-column">
                                <ui:Button name="generateButton" text="SYNTHESIZE POLICY (BRAIN)" class="action synthesize" />
                                <ui:Label name="brainState" text="Brain / baseline" class="brain-status" />
                                <ui:Label name="modelIdentity" text="Model / none" class="model-name" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="operator-status-row">
                            <ui:Label name="voiceStatus" text="Voice ready · 5 s maximum" class="media-status" />
                            <ui:Label name="voiceDraft" text="" class="voice-draft" />
                            <ui:Label name="compilerDiagnostics" text="" class="diagnostic-text" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="semanticsView" class="dock-view semantics-view">
                        <ui:VisualElement class="semantic-status-row">
                            <ui:Label name="semanticStatus" text="No active perception session" class="media-status" />
                            <ui:Label name="semanticSelected" text="Select a confirmed object" class="media-status semantic-selected" />
                        </ui:VisualElement>
                        <ui:VisualElement class="semantic-selection-row">
                            <ui:Label text="TRACK" class="section-title semantic-track-caption" />
                            <ui:DropdownField name="semanticTrack" label="" class="semantic-field semantic-track" />
                            <ui:Button name="loadSemanticButton" text="LOAD TAG" class="mission-button compact-action" />
                        </ui:VisualElement>
                        <ui:VisualElement class="semantic-edit-row">
                            <ui:TextField name="semanticLabel" label="LABEL" max-length="96" class="semantic-field semantic-label" />
                            <ui:DropdownField name="semanticRole" label="ROLE" class="semantic-field semantic-choice" />
                            <ui:DropdownField name="semanticHazard" label="HAZARD" class="semantic-field semantic-choice" />
                        </ui:VisualElement>
                        <ui:VisualElement class="mission-row semantic-actions">
                            <ui:Button name="applySemanticButton" text="APPLY OPERATOR TAG" class="mission-button" />
                            <ui:Button name="clearSemanticButton" text="USE MODEL TAG" class="mission-button" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="sceneryView" class="dock-view scenery-view">
                        <ui:TextField name="sceneryPrompt" label="SURFACE DESCRIPTION" value="Dark industrial warehouse floor" max-length="1000" class="semantic-field scenery-prompt" />
                        <ui:VisualElement class="mission-row scenery-actions">
                            <ui:Button name="generateSceneryButton" text="GENERATE SURFACE" class="mission-button" />
                            <ui:Button name="resetSceneryButton" text="RESTORE DEFAULT" class="mission-button" />
                        </ui:VisualElement>
                        <ui:Label name="sceneryStatus" text="Default tactical surface" class="media-status" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="swarm-panel" picking-mode="Position">
                <ui:Label text="SWARM CONTROL" class="section-title" />
                <ui:Label name="activePolicy" text="EmergencyHoldPolicy" class="policy-name" />
                <ui:Label name="agentTelemetry" text="Awaiting measured agent telemetry" class="telemetry-text" />
                <ui:Button name="lidarToggleButton" text="SHOW LIDAR BEAMS" class="mission-button lidar-toggle" />
                <ui:Label name="controlReason" text="Waiting for trustworthy source" class="notice control-reason" />
                <ui:VisualElement class="mission-row policy-actions">
                    <ui:Button name="patrolButton" text="PATROL" class="mission-button" />
                    <ui:Button name="cordonButton" text="CORDON" class="mission-button" />
                </ui:VisualElement>
                <ui:VisualElement class="mission-row policy-actions">
                    <ui:Button name="searchButton" text="GRID SEARCH" class="mission-button" />
                    <ui:Button name="holdButton" text="HOLD" class="mission-button" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="footer" picking-mode="Ignore">
            <ui:Label name="performanceMetrics" text="FPS --  /  FRAME -- ms  /  SOURCE AGE -- ms  /  SANDBOX -- ms" class="footer-text" />
            <ui:Label text="LIVE GEOMETRY APPEARS ONLY FROM CURRENT OBSERVATIONS" class="footer-text" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
