.screen {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    padding: 26px;
    color: rgb(222, 237, 240);
    font-size: 16px;
    -unity-font-definition: url("project://database/Assets/_OmniTwin/UI/TacticalHud/OmniTwinSans.asset");
}
.header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 18px 24px;
    background-color: rgba(7, 16, 23, 0.95);
    border-bottom-width: 2px;
    border-bottom-color: rgb(33, 211, 191);
}
.brand { font-size: 30px; -unity-font-style: bold; letter-spacing: 5px; }
.eyebrow { font-size: 11px; letter-spacing: 3px; color: rgb(122, 158, 171); margin-top: 5px; }
.header-right { align-items: flex-end; }
.badge { color: rgb(238, 184, 100); font-size: 13px; -unity-font-style: bold; letter-spacing: 1px; }
.live .badge { color: rgb(66, 238, 207); }
.connection { font-size: 12px; color: rgb(139, 166, 177); margin-top: 6px; }
.source-mode { margin-top: 7px; color: rgb(80, 232, 205); font-size: 11px; -unity-font-style: bold; letter-spacing: 1px; }
.synthetic-source .source-mode { color: rgb(255, 92, 64); background-color: rgba(72, 20, 20, 0.9); padding: 5px 8px; border-left-width: 3px; border-left-color: rgb(255, 77, 55); }
.body { flex-grow: 1; flex-direction: row; margin-top: 20px; }
.sidebar {
    width: 286px;
    align-self: flex-start;
    padding: 22px;
    background-color: rgba(7, 16, 23, 0.94);
    border-left-width: 2px;
    border-left-color: rgb(39, 91, 105);
}
.section-title { font-size: 11px; letter-spacing: 2px; color: rgb(115, 157, 170); margin-bottom: 8px; }
.big-value { font-size: 38px; -unity-font-style: bold; color: rgb(234, 247, 246); }
.value-caption { font-size: 12px; color: rgb(139, 168, 178); margin-bottom: 6px; }
.metric { flex-direction: row; justify-content: space-between; margin-top: 8px; }
.metric-name { color: rgb(139, 168, 178); font-size: 13px; }
.metric-value { color: rgb(225, 240, 241); font-size: 13px; -unity-font-style: bold; }
.divider { height: 1px; background-color: rgb(32, 57, 68); margin-top: 13px; margin-bottom: 13px; }
.notice { color: rgb(180, 203, 211); font-size: 13px; white-space: normal; }
.action {
    margin-top: 22px;
    padding: 12px;
    background-color: rgb(19, 53, 61);
    color: rgb(112, 243, 217);
    border-width: 1px;
    border-color: rgb(42, 117, 119);
    -unity-text-align: middle-center;
    font-size: 13px;
    -unity-font-style: bold;
}
.action:hover { background-color: rgb(28, 79, 85); }
.action:focus { border-color: rgb(111, 247, 219); }
.action:active { background-color: rgb(13, 38, 46); }
.action:disabled { color: rgb(99, 127, 135); background-color: rgb(21, 37, 45); }
.workspace-meta { min-width: 148px; margin-right: 12px; }
.world-spacer { flex-grow: 1; min-width: 0; }
.world-caption { flex-grow: 1; align-items: flex-end; justify-content: flex-end; padding: 0 12px 18px 22px; }
.world-title { font-size: 12px; letter-spacing: 3px; color: rgb(124, 170, 182); }
.world-detail { font-size: 11px; color: rgb(104, 137, 149); margin-top: 6px; }
.camera-toolbar { flex-direction: row; align-items: center; flex-shrink: 0; }
.camera-presets { flex-direction: row; margin-top: 0; align-self: auto; }
.camera-button { min-width: 74px; margin: 2px; padding: 7px 5px; background-color: rgb(10, 31, 40); color: rgb(148, 220, 219); border-width: 1px; border-color: rgb(39, 101, 111); font-size: 11px; }
.camera-button:hover { background-color: rgb(20, 61, 69); }
.camera-agent { width: 164px; margin: 0 0 0 8px; align-self: center; font-size: 11px; }
.camera-agent .unity-base-field__input { background-color: rgb(10, 27, 35); color: rgb(214, 235, 235); }
.model-matrix { font-size: 11px; color: rgb(195, 216, 220); white-space: normal; }
.matrix-caption { margin-top: 8px; color: rgb(125, 158, 168); font-size: 9px; white-space: normal; }
.footer { flex-direction: row; justify-content: space-between; padding: 16px 2px 0 2px; }
.footer-text { font-size: 11px; color: rgb(127, 162, 174); }
.compact .sidebar { width: 240px; padding: 12px; }
.compact .brand { font-size: 24px; letter-spacing: 3px; }
.compact .header { padding: 14px 18px; }
.swarm-panel { width: 300px; flex-shrink: 0; padding: 16px; background-color: rgba(7, 16, 23, 0.94); border-right-width: 2px; border-right-color: rgb(39, 91, 105); }
.swarm-panel .section-title { margin-bottom: 10px; }
.policy-name { font-size: 15px; color: rgb(95, 237, 208); white-space: normal; margin-bottom: 12px; }
.telemetry-text { font-size: 13px; color: rgb(203, 225, 229); white-space: normal; margin-bottom: 14px; }
.mission-row { flex-direction: row; flex-shrink: 0; min-height: 42px; }
.mission-button { flex-grow: 1; width: 48%; margin: 3px; padding: 8px 3px; background-color: rgb(19, 53, 61); color: rgb(167, 235, 224); border-width: 1px; border-color: rgb(42, 117, 119); font-size: 12px; }
.mission-button:hover { background-color: rgb(28, 79, 85); }
.mission-input { margin-top: 12px; min-height: 70px; flex-direction: column; font-size: 12px; }
.mission-input .unity-text-field__label { margin-bottom: 6px; }
.mission-input .unity-text-field__input { background-color: rgb(13, 30, 40); color: rgb(221, 240, 239); white-space: normal; min-height: 48px; }
.synthesize { margin-top: 10px; margin-bottom: 12px; padding: 10px; }
.model-name { margin-top: 6px; font-size: 11px; color: rgb(239, 191, 114); white-space: normal; }
.diagnostic-text { margin-top: 8px; font-size: 11px; color: rgb(199, 174, 164); white-space: normal; }
.compact .swarm-panel { width: 260px; padding: 12px; }
.swarm-panel .unity-scroll-view__content-container > * { flex-shrink: 0; }
.mission-button { min-height: 36px; flex-basis: 0; width: auto; }
.mission-button:active, .dock-tab:active, .camera-button:active { background-color: rgb(7, 39, 47); border-color: rgb(74, 230, 202); scale: 0.99 0.99; }
.mission-button:disabled { color: rgb(99, 127, 135); background-color: rgb(18, 31, 38); border-color: rgb(39, 56, 62); }
.track-pick { min-width: 58px; max-width: 75px; min-height: 15px; max-height: 15px; flex-grow: 0; flex-shrink: 0; margin: 0 2px; padding: 1px 3px; font-size: 7px; }
.track-pick.track-selected, .policy-actions .policy-active { color: rgb(117, 255, 221); background-color: rgb(13, 75, 70); border-color: rgb(64, 245, 204); -unity-font-style: bold; }
.track-pick:disabled { color: rgb(99, 127, 135); background-color: rgb(18, 31, 38); }
.dock-tab:hover { background-color: rgb(19, 59, 65); }
.camera-button:active { color: rgb(230, 255, 251); }
.header, .footer { flex-shrink: 0; }
.body { flex-basis: 0; min-height: 0; }
.swarm-panel { height: 100%; min-height: 0; overflow: hidden; }
.swarm-panel .unity-scroll-view__content-viewport { overflow: hidden; }
.observation-panel { height: 100%; min-height: 0; overflow: hidden; }
.observation-panel .unity-scroll-view__content-container > * { flex-shrink: 0; }
.camera-preview { height: 190px; margin-top: 10px; margin-bottom: 12px; position: relative; }
.preview-image { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.semantic-field { flex-direction: column; margin-top: 8px; margin-bottom: 8px; font-size: 12px; }
.semantic-field .unity-base-field__label { margin-bottom: 4px; }
.semantic-field .unity-base-field__input { background-color: rgb(13, 30, 40); color: rgb(221, 240, 239); min-height: 28px; }
.mission-button:focus { border-color: rgb(132, 245, 217); }
.preview-hidden { display: none; }
.preview-toggle { flex-basis: auto; flex-shrink: 0; min-height: 32px; margin: 2px; padding: 4px 3px; font-size: 11px; }
.voice-record { flex-basis: auto; flex-shrink: 0; min-height: 38px; }
.media-status { font-size: 11px; white-space: nowrap; overflow: hidden; color: rgb(160, 194, 206); margin-top: 2px; margin-bottom: 2px; }
.sidebar { padding: 14px; }
.voice-draft { font-size: 12px; white-space: normal; color: rgb(221, 236, 231); max-height: 72px; overflow: hidden; }

/* Fixed text boxes keep the dashboard readable with the bundled narrow tactical font. */
.screen { height: 100%; min-height: 0; overflow: hidden; }
.header { flex-shrink: 0; }
.body { flex-grow: 1; min-height: 0; overflow: hidden; }
.sidebar, .swarm-panel { min-width: 0; flex-shrink: 0; }
.metric {
    min-height: 20px;
    height: 20px;
    margin-top: 0;
    margin-bottom: 2px;
    flex-shrink: 0;
    align-items: center;
}
.metric-name, .metric-value {
    min-height: 18px;
    margin-top: 0;
    margin-bottom: 0;
    flex-shrink: 0;
    white-space: nowrap;
}
.metric-value { min-width: 78px; text-align: right; }
.telemetry-text { flex-shrink: 0; white-space: pre; }
.camera-preview { width: 192px; height: 144px; min-height: 144px; align-self: center; flex-shrink: 0; }
.preview-replay-badge {
    position: absolute;
    top: 6px;
    left: 6px;
    max-height: 24px;
    padding: 4px 6px;
    color: rgb(255, 235, 224);
    background-color: rgba(111, 32, 24, 0.94);
    border-left-width: 3px;
    border-left-color: rgb(255, 113, 82);
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}
.world-caption { min-width: 0; min-height: 0; padding-bottom: 28px; }
.camera-toolbar { min-width: 0; }
.workspace-meta { flex-shrink: 0; }
.camera-presets { flex-shrink: 0; margin-top: 0; }
.camera-button { min-height: 36px; min-width: 76px; flex-shrink: 0; font-size: 12px; }
.camera-agent { width: 164px; height: 58px; min-height: 58px; margin: 0 0 0 8px; padding-bottom: 3px; flex-shrink: 0; }
.footer {
    height: 56px;
    min-height: 56px;
    max-height: 56px;
    flex-shrink: 0;
    align-items: center;
    padding: 2px 2px 0;
    margin-top: 2px;
}
.footer-text {
    min-height: 22px;
    padding: 2px 3px;
    font-size: 14px;
    -unity-font-style: bold;
    flex-shrink: 0;
    white-space: nowrap;
}

/* The side panels stay fixed; tabs keep every operator function in a shallow dock. */
.body { align-items: stretch; }
.observation-panel {
    width: 286px;
    height: auto;
    max-height: 100%;
    align-self: flex-start;
    overflow: visible;
    padding: 14px;
}
.swarm-panel {
    width: 300px;
    height: auto;
    max-height: 100%;
    align-self: flex-start;
    overflow: visible;
    padding: 14px;
}
.world-column { flex-grow: 1; min-width: 0; min-height: 0; flex-direction: column; justify-content: flex-end; }
.world-stage { flex-grow: 1; min-height: 0; }
.operation-strip {
    min-height: 42px;
    height: 42px;
    max-height: 42px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    margin: 0 5px 3px;
    padding: 4px 9px;
    background-color: rgba(9, 31, 38, 0.96);
    border-left-width: 3px;
    border-left-color: rgb(40, 217, 189);
    border-top-width: 1px;
    border-top-color: rgba(51, 120, 128, 0.9);
    border-bottom-width: 1px;
    border-bottom-color: rgba(51, 120, 128, 0.9);
}
.operation-message { flex-grow: 1; min-width: 0; max-height: 26px; margin-right: 8px; color: rgb(171, 235, 225); font-size: 10px; -unity-font-style: bold; white-space: normal; overflow: hidden; }
.operation-progress { width: 150px; min-width: 120px; max-width: 190px; height: 17px; flex-shrink: 0; margin-right: 10px; }
.operation-progress .unity-progress-bar__progress { background-color: rgb(29, 201, 177); }
.operation-progress .unity-progress-bar__title { color: rgb(218, 240, 239); font-size: 8px; }
.last-action { width: 155px; min-width: 142px; max-height: 25px; color: rgb(137, 174, 182); font-size: 8px; white-space: normal; overflow: hidden; }
.operation-strip.operation-working { border-left-color: rgb(255, 184, 74); background-color: rgba(49, 37, 20, 0.96); }
.operation-working .operation-message { color: rgb(255, 220, 153); }
.operation-working .operation-progress .unity-progress-bar__progress { background-color: rgb(255, 176, 59); }
.operation-strip.operation-complete { border-left-color: rgb(50, 236, 189); }
.operation-complete .operation-message { color: rgb(129, 255, 220); }
.operation-strip.operation-failed { border-left-color: rgb(255, 105, 84); background-color: rgba(58, 25, 24, 0.97); }
.operation-failed .operation-message { color: rgb(255, 165, 143); }
.model-active { color: rgb(126, 255, 207); background-color: rgba(10, 64, 54, 0.98); border-left-color: rgb(64, 242, 183); }
.command-dock {
    height: 132px;
    min-height: 132px;
    max-height: 132px;
    flex-shrink: 0;
    overflow: hidden;
    padding: 3px 5px 4px;
    background-color: rgba(5, 14, 21, 0.96);
    border-top-width: 2px;
    border-top-color: rgb(33, 211, 191);
    border-left-width: 1px;
    border-left-color: rgba(49, 116, 126, 0.8);
    border-right-width: 1px;
    border-right-color: rgba(49, 116, 126, 0.8);
}
.dock-title { height: 10px; min-height: 10px; max-height: 10px; margin-bottom: 1px; color: rgb(90, 237, 211); font-size: 8px; -unity-font-style: bold; letter-spacing: 1px; flex-shrink: 0; }
.model-matrix { height: 26px; min-height: 26px; max-height: 26px; flex-direction: row; flex-shrink: 0; margin-bottom: 2px; }
.model-card {
    height: 26px;
    min-height: 26px;
    max-height: 26px;
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    margin-right: 4px;
    padding: 2px 4px;
    overflow: hidden;
    color: rgb(190, 220, 222);
    background-color: rgba(11, 32, 41, 0.96);
    border-left-width: 2px;
    border-left-color: rgb(42, 117, 119);
    font-size: 7px;
    white-space: normal;
    flex-shrink: 0;
}
.sandbox-card { margin-right: 0; border-left-color: rgb(234, 184, 99); }
.dock-tabs { height: 20px; min-height: 20px; max-height: 20px; flex-direction: row; flex-shrink: 0; margin-bottom: 2px; }
.dock-tab { flex-grow: 1; min-width: 0; min-height: 18px; margin: 0 3px 0 0; padding: 2px 4px; color: rgb(150, 194, 198); background-color: rgb(9, 26, 34); border-width: 1px; border-color: rgb(36, 76, 86); font-size: 8px; -unity-font-style: bold; }
.dock-tab.selected { color: rgb(104, 248, 217); background-color: rgb(15, 50, 56); border-color: rgb(42, 148, 137); }
.dock-view { display: none; height: 62px; min-height: 62px; max-height: 62px; min-width: 0; flex-direction: column; overflow: hidden; }
.dock-view.active { display: flex; }
.command-primary-row { height: 40px; min-height: 40px; max-height: 40px; flex-direction: row; align-items: stretch; flex-shrink: 0; }
.voice-column { width: 108px; flex-shrink: 0; margin-right: 5px; }
.voice-record { width: 100%; min-height: 24px; max-height: 24px; margin: 0 0 1px; padding: 2px; font-size: 8px; }
.voice-actions { height: 15px; min-height: 15px; max-height: 15px; }
.voice-actions .mission-button { min-height: 14px; max-height: 14px; margin: 0 1px; padding: 1px; font-size: 7px; }
.mission-input {
    height: 40px;
    min-height: 40px;
    max-height: 40px;
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    margin: 0 5px 0 0;
    padding: 1px 4px;
    background-color: rgba(10, 29, 38, 0.98);
    border-left-width: 1px;
    border-left-color: rgb(38, 99, 109);
    font-size: 8px;
}
.mission-input .unity-text-field__label { margin-bottom: 0; font-size: 7px; }
.mission-input .unity-text-field__input { min-height: 20px; padding: 1px 3px; font-size: 8px; }
.synthesis-column { width: 165px; flex-shrink: 0; }
.synthesize { min-height: 24px; max-height: 24px; margin: 0; padding: 2px; font-size: 8px; }
.brain-status, .model-name { min-height: 10px; max-height: 10px; margin-top: 0; font-size: 7px; white-space: nowrap; overflow: hidden; }
.brain-status { color: rgb(108, 238, 210); }
.model-name { color: rgb(239, 191, 114); }
.operator-status-row { height: 14px; min-height: 14px; max-height: 14px; flex-direction: row; align-items: center; margin-top: 1px; flex-shrink: 0; }
.operator-status-row > * { min-width: 0; margin: 0 4px 0 0; }
.operator-status-row .media-status { flex-basis: 130px; flex-grow: 1; margin: 0; font-size: 7px; }
.operator-status-row .voice-draft { flex-basis: 135px; flex-grow: 1; max-height: 12px; white-space: nowrap; overflow: hidden; font-size: 7px; }
.operator-status-row .diagnostic-text { flex-basis: 180px; flex-grow: 2; max-height: 12px; margin: 0; font-size: 7px; white-space: nowrap; overflow: hidden; }
.semantics-view { height: 60px; min-height: 60px; max-height: 60px; }
.semantic-status-row { height: 10px; min-height: 10px; max-height: 10px; flex-direction: row; align-items: center; }
.semantic-status-row .media-status { flex-grow: 1; min-width: 0; margin: 0 5px 0 0; font-size: 7px; }
.semantic-selection-row, .semantic-edit-row { flex-direction: row; align-items: center; height: 16px; min-height: 16px; max-height: 16px; }
.semantic-field { min-width: 0; margin: 0 3px 0 0; font-size: 7px; }
.semantic-field .unity-base-field__label { margin-bottom: 0; font-size: 6px; }
.semantic-field .unity-base-field__input { min-height: 12px; padding: 0 2px; font-size: 7px; }
.semantic-track-caption { width: 38px; min-width: 38px; max-height: 10px; margin: 0 3px 0 0; font-size: 7px; letter-spacing: 0; flex-shrink: 0; }
.semantic-selection-row .semantic-track { width: 104px; min-width: 104px; max-width: 104px; height: 15px; min-height: 15px; max-height: 15px; flex-basis: 104px; flex-grow: 0; }
.semantic-label { flex-grow: 1; flex-basis: 0; }
.semantic-choice { width: 86px; flex-shrink: 0; }
.compact-action { width: 82px; min-width: 82px; max-width: 82px; min-height: 14px; max-height: 14px; flex-grow: 0; flex-shrink: 0; margin: 0 0 0 3px; padding: 1px; font-size: 7px; }
.semantic-actions, .scenery-actions { height: 16px; min-height: 16px; max-height: 16px; }
.semantic-actions .mission-button, .scenery-actions .mission-button { min-height: 14px; max-height: 14px; margin: 0 3px 0 0; padding: 1px 3px; font-size: 7px; }
.scenery-view { height: 60px; min-height: 60px; max-height: 60px; }
.scenery-prompt { height: 25px; min-height: 25px; max-height: 25px; margin: 0 0 1px; font-size: 7px; }
.scenery-prompt .unity-text-field__label { margin-bottom: 0; font-size: 6px; }
.scenery-prompt .unity-text-field__input { min-height: 15px; padding: 0 3px; font-size: 7px; }
.scenery-view .media-status { min-height: 11px; max-height: 11px; margin: 0; font-size: 7px; }
.reconnect { min-height: 32px; margin: 5px 0 0; padding: 5px; font-size: 10px; }
.control-reason { min-height: 24px; max-height: 30px; margin: 2px 0 4px; overflow: hidden; font-size: 10px; }
.lidar-toggle { min-height: 30px; margin: 0 0 3px; padding: 5px 3px; font-size: 10px; }
.policy-actions { min-height: 29px; }
.policy-actions .mission-button { min-height: 27px; margin: 1px; padding: 4px 3px; font-size: 10px; }
.camera-preview { width: 192px; height: 112px; min-height: 112px; margin: 7px 0; align-self: center; flex-shrink: 0; }
.compact .observation-panel { width: 240px; padding: 10px; }
.compact .swarm-panel { width: 250px; padding: 10px; }
.compact .voice-column { width: 108px; }
.compact .synthesis-column { width: 154px; }
.compact .command-dock { padding: 4px; }
.compact .model-card { font-size: 7px; padding: 2px; }
.compact .semantic-choice { width: 86px; }
.compact .camera-preview { width: 160px; height: 96px; min-height: 96px; }
.swarm-panel .section-title { margin-bottom: 5px; }
.swarm-panel .policy-name { margin-bottom: 5px; font-size: 13px; }
.swarm-panel .telemetry-text { margin-bottom: 7px; font-size: 11px; }
.swarm-panel .control-reason { font-size: 10px; }

/* The optional standalone demo presenter is created only with --omnitwin-demo. */
.demo-presenter {
    position: absolute;
    left: 23%;
    right: 23%;
    bottom: 205px;
    min-height: 82px;
    max-height: 116px;
    padding: 9px 16px 8px;
    background-color: rgba(5, 15, 22, 0.94);
    border-left-width: 4px;
    border-left-color: rgb(41, 223, 195);
    border-top-width: 1px;
    border-top-color: rgba(65, 157, 163, 0.85);
    border-bottom-width: 1px;
    border-bottom-color: rgba(65, 157, 163, 0.85);
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
}
.demo-chapter {
    min-height: 18px;
    margin-bottom: 4px;
    color: rgb(63, 239, 210);
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    white-space: nowrap;
    overflow: hidden;
}
.demo-subtitle {
    min-height: 32px;
    color: rgb(230, 240, 241);
    font-size: 13px;
    white-space: normal;
    overflow: hidden;
}
.demo-source {
    min-height: 12px;
    margin-top: 3px;
    color: rgb(246, 157, 119);
    font-size: 8px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    white-space: nowrap;
    overflow: hidden;
}
.demo-highlight {
    border-width: 2px;
    border-color: rgb(255, 191, 94);
    background-color: rgba(111, 65, 21, 0.96);
    color: rgb(255, 238, 204);
}
.demo-cursor {
    position: absolute;
    width: 24px;
    height: 24px;
    border-radius: 12px;
    border-width: 2px;
    border-color: rgb(255, 249, 222);
    background-color: rgba(255, 189, 77, 0.72);
    transition-property: left, top;
    transition-duration: 260ms;
    transition-timing-function: ease-out;
}
.demo-click-ripple {
    position: absolute;
    left: -5px;
    top: -5px;
    width: 30px;
    height: 30px;
    border-radius: 16px;
    border-width: 2px;
    border-color: rgba(255, 248, 215, 0.92);
    background-color: rgba(255, 182, 72, 0.12);
    transition-property: left, top, width, height, border-color, background-color;
    transition-duration: 360ms;
    transition-timing-function: ease-out;
}
.demo-cursor-pulse .demo-click-ripple {
    left: -20px;
    top: -20px;
    width: 60px;
    height: 60px;
    border-color: rgba(61, 255, 221, 0.96);
    background-color: rgba(31, 224, 190, 0.06);
}

/* Stage 8 product presentation: camera-first observation, readable unit cards, and a compact flow strip. */
.observation-panel { padding: 12px; }
.observation-panel > .section-title { margin-bottom: 5px; }
.camera-preview {
    width: 100%;
    height: 154px;
    min-height: 154px;
    margin: 3px 0 7px;
    align-self: stretch;
    background-color: rgb(8, 19, 26);
    border-width: 1px;
    border-color: rgb(38, 101, 110);
}
.preview-controls { flex-direction: row; min-height: 31px; flex-shrink: 0; }
.preview-controls .preview-toggle { flex-basis: 0; width: 50%; min-width: 0; min-height: 29px; margin: 1px 2px; font-size: 9px; }
.preview-status-row { flex-direction: row; min-height: 20px; margin-bottom: 4px; }
.preview-status-row .media-status { flex-basis: 0; flex-grow: 1; min-width: 0; margin: 0 3px; font-size: 8px; }
.track-summary { flex-direction: row; margin: 3px 0 6px; }
.summary-card {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    min-height: 54px;
    margin-right: 5px;
    padding: 4px 8px;
    background-color: rgba(10, 32, 41, 0.96);
    border-left-width: 2px;
    border-left-color: rgb(38, 207, 184);
}
.summary-card.hazard-summary { margin-right: 0; border-left-color: rgb(250, 104, 73); }
.summary-value { color: rgb(228, 246, 244); font-size: 25px; -unity-font-style: bold; }
.hazard-summary .summary-value { color: rgb(255, 147, 111); }
.summary-caption { color: rgb(131, 170, 178); font-size: 8px; letter-spacing: 1px; }
.observation-panel .metric { min-height: 19px; height: 19px; margin-bottom: 2px; padding: 0 4px; background-color: rgba(11, 24, 31, 0.82); }
.observation-panel .metric-name, .observation-panel .metric-value { font-size: 10px; }
.observation-panel .metric-value { min-width: 80px; }
.observation-panel .notice { min-height: 34px; max-height: 47px; margin-top: 5px; font-size: 9px; overflow: hidden; }
.observation-panel .reconnect { min-height: 29px; margin-top: 4px; }
.pipeline-strip {
    height: 34px;
    min-height: 34px;
    max-height: 34px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin: 0 5px 3px;
    padding: 2px 7px;
    background-color: rgba(7, 16, 23, 0.94);
    border-bottom-width: 1px;
    border-bottom-color: rgba(47, 123, 132, 0.7);
    flex-shrink: 0;
}
.pipeline-stage { flex-grow: 1; min-width: 0; color: rgb(156, 205, 207); font-size: 8px; -unity-font-style: bold; letter-spacing: 0.5px; white-space: nowrap; -unity-text-align: middle-center; }
.pipeline-arrow { width: 16px; color: rgb(50, 223, 190); font-size: 17px; -unity-text-align: middle-center; }
.unit-cards { flex-grow: 1; min-height: 0; flex-direction: column; margin-bottom: 4px; }
.unit-card {
    min-height: 51px;
    flex-basis: 51px;
    flex-grow: 1;
    flex-shrink: 0;
    margin: 1px 0 3px;
    padding: 4px 6px 3px;
    background-color: rgba(10, 27, 36, 0.95);
    border-left-width: 3px;
    border-left-color: rgb(50, 211, 197);
}
.unit-card.aerial-card { border-left-color: rgb(255, 183, 87); }
.unit-card-header { flex-direction: row; justify-content: space-between; align-items: center; min-height: 16px; }
.unit-card-title { color: rgb(218, 236, 238); font-size: 9px; -unity-font-style: bold; letter-spacing: 0.4px; white-space: nowrap; }
.unit-status { min-width: 68px; padding: 2px 4px; color: rgb(167, 184, 187); background-color: rgba(70, 85, 89, 0.55); font-size: 7px; -unity-font-style: bold; -unity-text-align: middle-center; white-space: nowrap; }
.unit-status.status-navigating { color: rgb(72, 247, 201); background-color: rgba(7, 80, 68, 0.8); }
.unit-status.status-holding { color: rgb(255, 197, 111); background-color: rgba(82, 55, 20, 0.82); }
.unit-status.status-idle { color: rgb(166, 207, 220); background-color: rgba(25, 54, 66, 0.84); }
.unit-status.status-lowbattery, .unit-status.status-offline { color: rgb(255, 130, 112); background-color: rgba(94, 30, 27, 0.86); }
.unit-card-detail { color: rgb(153, 183, 192); font-size: 8px; white-space: nowrap; overflow: hidden; margin-top: 2px; }
.policy-actions .policy-active {
    color: rgb(117, 255, 221);
    background-color: rgb(13, 75, 70);
    border-color: rgb(64, 245, 204);
    -unity-font-style: bold;
}
.voice-column { width: 128px; }
.voice-actions .mission-button { min-width: 0; }
.voice-actions #useTranscriptButton { flex-grow: 1.35; font-size: 6px; }
.mission-input .unity-text-field__input { -unity-text-align: middle-left; }
.compact .pipeline-strip { margin-left: 2px; margin-right: 2px; }
.compact .pipeline-stage { font-size: 7px; }
.compact .pipeline-arrow { width: 10px; }
.compact .observation-panel { padding: 8px; }
.compact .camera-preview { height: 126px; min-height: 126px; }
.compact .operation-progress { width: 120px; min-width: 100px; }
.compact .last-action { width: 128px; min-width: 118px; font-size: 7px; }
.compact .summary-card { min-height: 47px; padding: 3px 5px; }
.compact .summary-value { font-size: 22px; }
.compact .unit-card { padding-left: 4px; padding-right: 4px; }
.compact .unit-card-title { font-size: 8px; }
.compact .unit-card-detail { font-size: 7px; }
.compact .voice-column { width: 118px; }
