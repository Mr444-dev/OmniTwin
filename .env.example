# Set these in the process environment; this file is not loaded automatically.
META_API_KEY=
# Reserved for the planned Brain adapter; the current backend does not read this key.
BASETEN_API_KEY=

# Local backend defaults; enable perception only after configuring a measured calibration.
OmniTwin__Port=5108
OmniTwin__EnablePerception=false
OmniTwin__CameraDevice=0
OmniTwin__CalibrationPath=
OmniTwin__Concept=cup
OmniTwin__Hazard=false
